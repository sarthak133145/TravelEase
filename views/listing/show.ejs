<%-layout("./layout/boilerplate.ejs")%>

  <body>

    <div class="card col-8 offset-2 mt-2 showPageCard">
      <h3>
        <%=showListing.title%>
      </h3>
      <img src="<%=showListing.image.url%>" class="card-img-top showPageImage" alt="image"
        style="max-height: 18rem; object-fit: cover;">
      <div class="card-body">
        <p class="card-text">
         Owned by <i><%=showListing.owner.username%></i><br>
          <%=showListing.description%><br>
            ₹<%=showListing.price.toLocaleString("en-IN")%>/Night<br>
              <%=showListing.location%><br>
                <%=showListing.country%><br>
        </p>
      </div>
      <div class="d-flex gap-3 mb-3">
       <% if (currUser && currUser._id.equals(showListing.owner._id)){%>
        <form action="/listing/<%=showListing._id%>/edit" method="get">
          <button class="btn btn-danger">Edit</button>
        </form>

        <form action="/listing/<%=showListing._id%>?_method=Delete" method="post">
          <button class="btn btn-danger">Delete</button>
        </form>
        <%}%>
        
      </div>
      
      <%if(currUser){%>
        <hr>

         <h3>Leave a Review</h3>
      <form action="/listing/<%=showListing._id%>/review" method="post" class="needs-validation" novalidate>
        <label for="comment" class="form-label">Comment:</label>
        <textarea name="comment" class="form-control" required></textarea><br>
        <div class="invalid-feedback">
          Please enter a valid comment
        </div>

       
        <fieldset class=" starability-grow mb-3">
          <p>Rating:</p>
  <input type="radio" id="no-rate" class="input-no-rate" name="rating" value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="rating" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="rating" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="rating" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="rating" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="rating" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

        

        <button class="btn btn-danger">Submit</button>

      </form>

     <% }%>
     
      
     
<div class="row">

  
       <% for(let review of showListing.reviews){%>
        <hr>
         <h3>All review</h3>
      <div class="card col-4 mb-3 ms-2" >
  <div class="card-body ">
    <h5><%=review.author.username%></h5>
    <p class="card-text"><%=review.comment%><br>
    </p>
    <p class="starability-result" data-rating="<%=review.rating%>">
       </p>
    <form method="post" action="/listing/<%=showListing._id%>/review/<%=review._id%>?_method=delete">
   <% if(currUser && currUser._id.equals(review.author._id)){%>
      <button class="btn btn-danger">Delete</button>
   <% }%>
    </form>
  </div>
</div>
<%}%>
</div>


    </div>



  </body>